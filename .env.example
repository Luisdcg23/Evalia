ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
ConnectionStrings__EbrDatabase=Host=localhost;Port=5432;Database=ebr_bpm;Username=postgres;Password=replace-with-local-password
Jwt__Issuer=EBR.BPM.Local
Jwt__Audience=EBR.BPM.Frontend
Jwt__SigningKey=replace-with-at-least-32-random-characters
Frontend__Origin=http://localhost:5173
Minio__Endpoint=localhost:9000
Minio__AccessKey=ebr-local
Minio__SecretKey=replace-with-local-minio-secret
Minio__UseSsl=false
Minio__Bucket=evidencias-ebr
Email__Host=smtp.gmail.com
Email__Port=587
Email__User=replace-with-sender-account@gmail.com
Email__Password=replace-with-gmail-app-password
Email__FromAddress=replace-with-sender-account@gmail.com
Email__FromName=Evalia
